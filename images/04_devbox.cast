[0.001, "o", "\u001b]2;devbox add python@3.14 ruby@4 go@1.26\u0007\u001b]1;devbox\u0007"]
[0.397, "o", "\u001b[33mInfo: \u001b[0mAdding package \"python@3.14\" to devbox.json\r\n"]
[0.288, "o", "\u001b[33mInfo: \u001b[0mAdding package \"ruby@4\" to devbox.json\r\n"]
[0.137, "o", "\u001b[33mInfo: \u001b[0mAdding package \"go@1.26\" to devbox.json\r\n"]
[0.095, "o", "\r\npython NOTES:\r\nPython in Devbox works best when used with a virtual environment (venv, virtualenv, etc.). Devbox will automatically create a virtual environment using `venv` for python3 projects, so you can install packages with pip as normal.\r\nTo activate the environment, run `. $VENV_DIR/bin/activate` or add it to the init_hook of your devbox.json\r\nTo change where your virtual environment is created, modify the $VENV_DIR environment variable in your init_hook\r\n\r\nThis plugin creates the following helper files:\r\n* /Users/thesnapdragon/test-devbox/.devbox/virtenv/python/bin/venvShellHook.sh\r\n\r\nThis plugin sets the following environment variables:\r\n* VENV_DIR=/Users/thesnapdragon/test-devbox/.venv\r\n\r\nTo show this information, run `devbox info python`\r\n\r\n\r\n"]
[0.000, "o", "\r\nThis plugin sets the following environment variables:\r\n* PATH=/Users/thesnapdragon/test-devbox/.devbox/virtenv/ruby/bin/:$PATH\r\n* RUBY_CONFDIR=/Users/thesnapdragon/test-devbox/.devbox/virtenv/ruby\r\n* GEMRC=/Users/thesnapdragon/test-devbox/.devbox/virtenv/ruby/.gemrc\r\n* GEM_HOME=/Users/thesnapdragon/test-devbox/.devbox/virtenv/ruby\r\n\r\nTo show this information, run `devbox info ruby`\r\n\r\n\r\n"]
